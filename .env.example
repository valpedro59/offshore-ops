# --- auth-service ---
AUTH_PORT=4001
AUTH_DATABASE_URL=postgres://offshore:offshore@localhost:5433/auth
JWT_ACCESS_SECRET=change-me-with-at-least-32-characters-aaaa
ACCESS_TTL_SECONDS=900
REFRESH_TTL_DAYS=7

# --- stock-service ---
STOCK_PORT=4002
STOCK_DATABASE_URL=postgres://offshore:offshore@localhost:5434/stock

# --- commun ---
LOG_LEVEL=info
NODE_ENV=development
# --- gateway ---
GATEWAY_PORT=4000
AUTH_SERVICE_URL=http://localhost:4001
STOCK_SERVICE_URL=http://localhost:4002
CORS_ORIGINS=http://localhost:3000
# Nombre de proxys de confiance devant la gateway (0 en local ; 1 derrière un Ingress / load balancer)
TRUST_PROXY=0
UPSTREAM_TIMEOUT_MS=10000
RATE_LIMIT_IP_PER_MIN=300
RATE_LIMIT_AUTH_PER_MIN=10
RATE_LIMIT_USER_PER_MIN=600
