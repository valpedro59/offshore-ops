{
  "name": "offshore-ops",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20.6"
  },
  "scripts": {
    "dev": "pnpm -r --parallel --filter \"./apps/*\" dev",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "openapi": "pnpm --filter @offshore/shared openapi",
    "db:generate": "pnpm -r --filter \"./apps/*\" db:generate",
    "db:migrate": "pnpm -r --filter \"./apps/*\" db:migrate"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "22",
    "eslint": "^10.14.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "5",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0"
  }
}
