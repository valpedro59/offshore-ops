{
  "name": "@offshore/auth-service",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=../../.env src/index.ts",
    "start": "tsx --env-file=../../.env src/index.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file=../../.env src/migrate.ts"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.2.2",
    "@offshore/shared": "workspace:^",
    "drizzle-orm": "^0.45.4",
    "express": "5",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.1",
    "pino-http": "^11.0.0",
    "zod": "3"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.15",
    "@types/express": "5",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "drizzle-kit": "^0.31.11",
    "supertest": "^7.3.1"
  }
}
